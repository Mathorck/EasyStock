<?xml version="1.0" encoding="utf-8"?>
<!-- Only temp folders and backups are shared: the camera capture and the backups being shared by the user.
     The database is never exposed, and a stored photo only leaves with a URI grant the app gives. -->
<paths>
    <cache-path name="camera" path="camera/" />
    <cache-path name="backup" path="backup/share/" />
    <!-- Server mode: a server backup or the printed QR code PDF being saved or shared by an Admin -->
    <cache-path name="server" path="server/share/" />
    <!-- Automatic backups written before a server reset, shared by the user from the reset notice -->
    <files-path name="auto_backups" path="auto-backups/" />
    <!-- The same backups of the other profiles (profiles/<id>/auto-backups/). FileProvider has no
         wildcard, so the folder is listed: only files the app shares with a URI grant leave it. -->
    <files-path name="profile_files" path="profiles/" />
</paths>
