<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: no app data in Google cloud backups or device-to-device transfers. The stock, the
    photos, the automatic backups and the preferences stay on this phone (nFADP, GDPR: local by
    default). Moving data to another phone is done with the app's own backup (file, QR code, Wi-Fi).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
